<?xml version="1.0" encoding="utf-8"?>
<!--
  Accessibility service configuration for TouchpadAccessibilityService.

  accessibilityEventTypes="typeAllMask"
      Receive every event type so we can detect TYPE_VIEW_FOCUSED on the external display.

  accessibilityFlags:
    flagReportViewIds            — lets us read source.window.displayId to identify the glasses.
    flagRetrieveInteractiveWindows — required to see windows on non-default (glasses) displays
                                     (windowsOnAllDisplays) and to find the focused text field.

  canPerformGestures="true"
      Required to dispatch tap/drag/pinch gestures via dispatchGesture() on the glasses display.

  canRetrieveWindowContent="true"
      Required to read source.window / isEditable and to run paste / set-text / IME-enter
      actions on the focused field.
-->
<accessibility-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeAllMask"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:settingsActivity=".MainActivity" />
